<Window x:Class="Prescriva.Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:testing="clr-namespace:Prescriva.Agent.Desktop.Testing"
        Title="Prescriva Agent Configurator"
        Width="680" Height="820"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <TextBlock Text="1. Integration" FontWeight="Bold" Margin="0,0,0,4" />
            <UniformGrid Columns="2" Rows="2">
                <TextBlock Text="Integration ID:" VerticalAlignment="Center" />
                <TextBox x:Name="IntegrationIdBox" Text="sample-integration" Margin="2" />
                <TextBlock Text="Name:" VerticalAlignment="Center" />
                <TextBox x:Name="IntegrationNameBox" Text="Sample Integration" Margin="2" />
            </UniformGrid>
            <UniformGrid Columns="2" Rows="2" Margin="0,4,0,0">
                <TextBlock Text="Target process:" VerticalAlignment="Center" />
                <TextBox x:Name="ProcessIdentityBox" Text="Prescriva.Agent.TestTarget.exe" Margin="2" />
                <TextBlock Text="Window rule:" VerticalAlignment="Center" />
                <TextBox x:Name="WindowRuleBox" Text="Prescriva Agent Test Target" Margin="2" />
            </UniformGrid>
            <Button x:Name="CreateIntegrationButton" Content="Create Integration" Margin="0,6,0,0"
                    Click="CreateIntegrationButton_Click" HorizontalAlignment="Left" Padding="8,2" />

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="2. Stage" FontWeight="Bold" Margin="0,0,0,4" />
            <UniformGrid Columns="2" Rows="2">
                <TextBlock Text="Stage ID:" VerticalAlignment="Center" />
                <TextBox x:Name="StageIdBox" Text="intake" Margin="2" />
                <TextBlock Text="Stage name:" VerticalAlignment="Center" />
                <TextBox x:Name="StageNameBox" Text="Intake" Margin="2" />
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="AddStageButton" Content="Add Stage" Click="AddStageButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="RemoveStageButton" Content="Remove Stage" Click="RemoveStageButton_Click" Padding="8,2" />
            </StackPanel>

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="3. Inspect an element" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartInspectionButton" Content="Start Inspection" Click="StartInspectionButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="StopInspectionButton" Content="Stop Inspection" Click="StopInspectionButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="ConfirmSelectionButton" Content="Confirm Selection" Click="ConfirmSelectionButton_Click" Padding="8,2" />
            </StackPanel>
            <TextBlock x:Name="HoverStateText" Text="(inspection not started)" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="ConfirmedSelectionText" Text="(no confirmed selection)" Margin="0,4,0,0" TextWrapping="Wrap" FontStyle="Italic" />

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="4. Assign semantic ID and add field" FontWeight="Bold" Margin="0,0,0,4" />
            <UniformGrid Columns="2" Rows="2">
                <TextBlock Text="Semantic ID:" VerticalAlignment="Center" />
                <TextBox x:Name="FieldSemanticIdBox" Text="medication_name" Margin="2" />
                <TextBlock Text="Meaning:" VerticalAlignment="Center" />
                <TextBox x:Name="FieldMeaningBox" Text="Medication name" Margin="2" />
            </UniformGrid>
            <CheckBox x:Name="FieldRequiredBox" Content="Required" IsChecked="True" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="AddFieldButton" Content="Add Field From Confirmed Selection" Click="AddFieldButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="UpdateFieldButton" Content="Update Meaning/Required" Click="UpdateFieldButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="RemoveFieldButton" Content="Remove Field" Click="RemoveFieldButton_Click" Padding="8,2" />
            </StackPanel>

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="4b. Add trigger (button) from confirmed selection" FontWeight="Bold" Margin="0,0,0,4" />
            <UniformGrid Columns="2" Rows="2">
                <TextBlock Text="Trigger ID:" VerticalAlignment="Center" />
                <TextBox x:Name="TriggerSemanticIdBox" Text="add_item" Margin="2" />
                <TextBlock Text="Observed event:" VerticalAlignment="Center" />
                <TextBox x:Name="TriggerObservedEventBox" Text="Invoke" Margin="2" />
            </UniformGrid>
            <TextBlock Text="Actions, executed in this order:" Margin="0,6,0,2" FontStyle="Italic" />
            <UniformGrid Columns="2" Rows="4">
                <TextBlock Text="Capture fields (IDs, comma-separated):" VerticalAlignment="Center" />
                <TextBox x:Name="TriggerCaptureFieldsBox" Text="medication_name" Margin="2" />
                <TextBlock Text="Emit event (e.g. item_added):" VerticalAlignment="Center" />
                <TextBox x:Name="TriggerEmitEventBox" Text="item_added" Margin="2" />
                <TextBlock Text="Then go to stage (optional):" VerticalAlignment="Center" />
                <TextBox x:Name="TriggerTransitionStageBox" Text="" Margin="2" />
                <TextBlock Text="Finally:" VerticalAlignment="Center" />
                <ComboBox x:Name="TriggerTerminalBox" SelectedIndex="0" Margin="2">
                    <ComboBoxItem Content="Nothing" />
                    <ComboBoxItem Content="Finish session (budget_finished)" />
                    <ComboBoxItem Content="Cancel session" />
                </ComboBox>
            </UniformGrid>
            <CheckBox x:Name="TriggerClearStateBox" Content="Clear captured state after emitting" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="AddTriggerButton" Content="Add Trigger From Confirmed Selection" Click="AddTriggerButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="ReplaceTriggerActionsButton" Content="Replace Actions" Click="ReplaceTriggerActionsButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="RemoveTriggerButton" Content="Remove Trigger" Click="RemoveTriggerButton_Click" Padding="8,2" />
            </StackPanel>

            <TextBlock x:Name="ConfigurationSummaryText" Text="(no integration)" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
            <TextBlock x:Name="ApprovalStateText" Text="(no integration)" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="5. Save / reload" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="ReloadButton" Content="Reload From Disk" Click="ReloadButton_Click" Padding="8,2" />
            </StackPanel>

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="6. Resolve + read a saved field" FontWeight="Bold" Margin="0,0,0,4" />
            <UniformGrid Columns="2" Rows="1">
                <TextBlock Text="Field ID:" VerticalAlignment="Center" />
                <TextBox x:Name="ResolveFieldIdBox" Text="medication_name" Margin="2" />
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="ResolveButton" Content="Resolve" Click="ResolveButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="ReadValueButton" Content="Read Value" Click="ReadValueButton_Click" Padding="8,2" />
            </StackPanel>

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="7. Test mode (required before activation)" FontWeight="Bold" Margin="0,0,0,4" />
            <Button x:Name="PrepareTestButton" Content="Prepare Test Against Running Application" Click="PrepareTestButton_Click"
                    HorizontalAlignment="Left" Padding="8,2" />
            <testing:TestModeView x:Name="TestModeHost" Margin="0,4,0,0" Visibility="Collapsed" />

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="8. Activate and monitor" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ActivateButton" Content="Activate" Click="ActivateButton_Click" Padding="8,2" Margin="0,0,6,0" />
                <Button x:Name="StopMonitoringButton" Content="Stop" Click="StopMonitoringButton_Click" Padding="8,2" />
            </StackPanel>
            <TextBlock x:Name="MonitorStatusText" Text="Inativo." Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock x:Name="CapacityAlertText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="DarkOrange" FontWeight="SemiBold" Visibility="Collapsed" />
            <TextBlock Text="Diagnostics" Margin="0,6,0,2" FontStyle="Italic" />
            <ListBox x:Name="DiagnosticsList" Height="120" VirtualizingPanel.IsVirtualizing="False" DisplayMemberPath="Message" />
            <TextBlock Text="Persisted events (local encrypted queue)" Margin="0,6,0,2" FontStyle="Italic" />
            <ListBox x:Name="EventsList" Height="120" VirtualizingPanel.IsVirtualizing="False" DisplayMemberPath="Text" />
            <Button x:Name="ClearLocalDataButton" Content="Clear Local Data (events and technical log)..." Click="ClearLocalDataButton_Click"
                    HorizontalAlignment="Left" Padding="8,2" Margin="0,6,0,0" />

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="Status" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
