<Window x:Class="Prescriva.Agent.Desktop.Overlay.HighlightOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prescriva Agent Highlight Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False">
    <!--
        This window is never meant to receive input - the WS_EX_TRANSPARENT extended
        style set in code-behind (SourceInitialized) is what actually makes it
        click-through at the OS level. IsHitTestVisible="False" here is a WPF-level
        belt-and-braces measure; it does not by itself affect native hit testing.
    -->
    <Border x:Name="HighlightBorder"
            BorderBrush="#FF2F9BFF"
            BorderThickness="3"
            CornerRadius="2"
            Background="Transparent"
            IsHitTestVisible="False" />
</Window>
