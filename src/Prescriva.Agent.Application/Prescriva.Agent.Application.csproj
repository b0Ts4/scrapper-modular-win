<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Prescriva.Agent.Domain\Prescriva.Agent.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ResolvedElementHandle's constructor is internal so only Prescriva.Agent.Windows can
      construct (and therefore subclass, and dereference the contents of) a real handle -
      Application-layer code can hold and pass the type around but never build one itself.
    -->
    <InternalsVisibleTo Include="Prescriva.Agent.Windows" />
    <InternalsVisibleTo Include="Prescriva.Agent.Application.Tests" />
  </ItemGroup>

</Project>
