<Window x:Class="Prescriva.Agent.TestTarget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prescriva Agent Test Target"
        Height="700" Width="520">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="MedicationTextBox"
                 Grid.Row="0"
                 Margin="0,4"
                 AutomationProperties.AutomationId="MedicationTextBox" />

        <TextBox x:Name="ConcentrationTextBox"
                 Grid.Row="1"
                 Margin="0,4"
                 AutomationProperties.AutomationId="ConcentrationTextBox" />

        <TextBox x:Name="QuantityTextBox"
                 Grid.Row="2"
                 Margin="0,4"
                 AutomationProperties.AutomationId="QuantityTextBox" />

        <ComboBox x:Name="FormComboBox"
                  Grid.Row="3"
                  Margin="0,4"
                  AutomationProperties.AutomationId="FormComboBox">
            <ComboBoxItem Content="Tablet" />
            <ComboBoxItem Content="Capsule" />
            <ComboBoxItem Content="Liquid" />
        </ComboBox>

        <StackPanel x:Name="DynamicFieldPanel" Grid.Row="4" Orientation="Horizontal" Margin="0,4">
            <TextBox x:Name="DynamicField"
                     Width="220"
                     AutomationProperties.AutomationId="DynamicField" />
            <Button x:Name="ToggleDynamicFieldButton"
                    Content="Toggle Dynamic Field"
                    Margin="8,0,0,0"
                    Click="ToggleDynamicFieldButton_Click"
                    AutomationProperties.AutomationId="ToggleDynamicFieldButton" />
        </StackPanel>

        <!--
            File fields: a path box with a "Procurar..." browse button, and a drop zone
            that shows an image (dropped from Explorer, or the deterministic sample the
            tests load with "Mostrar imagem de exemplo").
        -->
        <StackPanel Grid.Row="9" Margin="0,4">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="Receita (arquivo):" Width="110" VerticalAlignment="Center" />
                <TextBox x:Name="PrescriptionFileTextBox" Width="250" />
                <Button x:Name="BrowsePrescriptionButton" Content="Procurar..." Margin="6,0,0,0" Click="BrowsePrescriptionButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Border x:Name="PrescriptionDropZone" Width="160" Height="100" BorderBrush="Gray" BorderThickness="1"
                        AllowDrop="True" Drop="PrescriptionDropZone_Drop" Background="WhiteSmoke">
                    <Image x:Name="PrescriptionImage" Stretch="Fill" />
                </Border>
                <Button x:Name="ShowSampleImageButton" Content="Mostrar imagem de exemplo" Margin="6,0,0,0"
                        VerticalAlignment="Top" Click="ShowSampleImageButton_Click" />
            </StackPanel>
        </StackPanel>

        <!--
            Fields with a visible label but NO AutomationId - the common case in real ERPs.
            Deliberately unnamed: in WPF an x:Name becomes the AutomationId, which is
            exactly what these controls must not have. The "alternate" layout reverses
            their order (same labels, different positions); "duplicate-labels" adds a
            second "Observações:" field so the label alone becomes ambiguous.
        -->
        <StackPanel x:Name="LabelledFieldsPanel" Grid.Row="8" Margin="0,4">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="Observações:" Width="90" VerticalAlignment="Center" />
                <TextBox Width="300" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="Lote:" Width="90" VerticalAlignment="Center" />
                <TextBox Width="300" />
            </StackPanel>
        </StackPanel>

        <!--
            Empty by default. Only populated (with a control that deliberately reuses the
            AutomationId "MedicationTextBox") when launched with the
            "duplicate-controls" layout variant, so tests can exercise a genuine,
            deterministic ambiguous-match scenario against a real UIA tree.
        -->
        <StackPanel x:Name="DuplicateControlsPanel" Grid.Row="7" Orientation="Horizontal" Margin="0,4" />

        <DataGrid x:Name="ItemsGrid"
                  Grid.Row="5"
                  Height="160"
                  Margin="0,4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AutomationProperties.AutomationId="ItemsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Medication" Binding="{Binding Medication}" />
                <DataGridTextColumn Header="Concentration" Binding="{Binding Concentration}" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel x:Name="ButtonsPanel" Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BackButton"
                    Content="Back"
                    Margin="0,0,8,0"
                    Click="BackButton_Click"
                    AutomationProperties.AutomationId="BackButton" />
            <Button x:Name="NextButton"
                    Content="Next"
                    Margin="0,0,8,0"
                    Click="NextButton_Click"
                    AutomationProperties.AutomationId="NextButton" />
            <Button x:Name="AddButton"
                    Content="Add"
                    Margin="0,0,8,0"
                    Click="AddButton_Click"
                    AutomationProperties.AutomationId="AddButton" />
            <Button x:Name="FinishButton"
                    Content="Finish"
                    Margin="0,0,8,0"
                    Click="FinishButton_Click"
                    AutomationProperties.AutomationId="FinishButton" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    AutomationProperties.AutomationId="CancelButton" />
            <!--
                A RichTextBox rather than a TextBlock: WPF's TextBlockAutomationPeer
                exposes no UI Automation pattern at all, so it could not stand in for a
                "read-only control with TextPattern but no ValuePattern" scenario.
                RichTextBoxAutomationPeer implements ITextProvider (TextPattern) without
                implementing IValueProvider (ValuePattern), which is exactly the
                compatible-pattern-fallback case this control exists to exercise.
            -->
            <RichTextBox x:Name="CompletionStatusText"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Width="120"
                         Height="24"
                         Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         AutomationProperties.AutomationId="CompletionStatusText">
                <FlowDocument>
                    <Paragraph>
                        <Run Text="Completed" />
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
        </StackPanel>
    </Grid>
</Window>
