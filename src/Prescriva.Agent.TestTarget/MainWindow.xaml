<Window x:Class="Prescriva.Agent.TestTarget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prescriva Agent Test Target"
        Height="480" Width="520">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="MedicationTextBox"
                 Grid.Row="0"
                 Margin="0,4"
                 AutomationProperties.AutomationId="MedicationTextBox" />

        <TextBox x:Name="ConcentrationTextBox"
                 Grid.Row="1"
                 Margin="0,4"
                 AutomationProperties.AutomationId="ConcentrationTextBox" />

        <TextBox x:Name="QuantityTextBox"
                 Grid.Row="2"
                 Margin="0,4"
                 AutomationProperties.AutomationId="QuantityTextBox" />

        <ComboBox x:Name="FormComboBox"
                  Grid.Row="3"
                  Margin="0,4"
                  AutomationProperties.AutomationId="FormComboBox">
            <ComboBoxItem Content="Tablet" />
            <ComboBoxItem Content="Capsule" />
            <ComboBoxItem Content="Liquid" />
        </ComboBox>

        <StackPanel x:Name="DynamicFieldPanel" Grid.Row="4" Orientation="Horizontal" Margin="0,4">
            <TextBox x:Name="DynamicField"
                     Width="220"
                     AutomationProperties.AutomationId="DynamicField" />
            <Button x:Name="ToggleDynamicFieldButton"
                    Content="Toggle Dynamic Field"
                    Margin="8,0,0,0"
                    Click="ToggleDynamicFieldButton_Click"
                    AutomationProperties.AutomationId="ToggleDynamicFieldButton" />
        </StackPanel>

        <DataGrid x:Name="ItemsGrid"
                  Grid.Row="5"
                  Height="160"
                  Margin="0,4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AutomationProperties.AutomationId="ItemsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Medication" Binding="{Binding Medication}" />
                <DataGridTextColumn Header="Concentration" Binding="{Binding Concentration}" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel x:Name="ButtonsPanel" Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BackButton"
                    Content="Back"
                    Margin="0,0,8,0"
                    Click="BackButton_Click"
                    AutomationProperties.AutomationId="BackButton" />
            <Button x:Name="NextButton"
                    Content="Next"
                    Margin="0,0,8,0"
                    Click="NextButton_Click"
                    AutomationProperties.AutomationId="NextButton" />
            <Button x:Name="AddButton"
                    Content="Add"
                    Margin="0,0,8,0"
                    Click="AddButton_Click"
                    AutomationProperties.AutomationId="AddButton" />
            <Button x:Name="FinishButton"
                    Content="Finish"
                    Margin="0,0,8,0"
                    Click="FinishButton_Click"
                    AutomationProperties.AutomationId="FinishButton" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    AutomationProperties.AutomationId="CancelButton" />
            <TextBlock x:Name="CompletionStatusText"
                       Text="Completed"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
